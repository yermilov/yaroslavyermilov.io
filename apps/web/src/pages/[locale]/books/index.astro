---
/**
 * /books/ — the live shelf (task 5abd736c). Rendered on every request (with a
 * 10-minute server cache in @lib/shelf) from juggernaut's /books miniapp:
 *   1. what is being read right now;
 *   2. every finished book in Yarik's own ranking — the same order the
 *      miniapp shows (stars, then the duels that break ties) — with his
 *      feedback in the page's language, folded away until asked for.
 * Covers carry the page, so they are big; there are no blurbs and no per-book
 * pages (the old /books/<slug>/ URLs redirect here).
 * A ledger, not a masonry wall: a ranking has to read in order, and CSS
 * columns fill top-to-bottom, which scrambles it.
 */
export const prerender = false;
import { LOCALES, t, type Locale } from '@lib/i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import { feedbackHtml, getShelf, type ShelfFinishedBook } from '@lib/shelf';

const locale = Astro.params.locale as Locale;
if (!LOCALES.includes(locale)) {
  return Astro.rewrite('/404/');
}
const strings = t(locale);
const shelf = await getShelf();
// Short shared cache: the server already holds a 10-minute copy, this only
// spares it a re-render on a burst of visits. The "unavailable" page is never
// cached — it would outlive the server's own one-minute retry.
Astro.response.headers.set('cache-control', shelf ? 'public, max-age=120' : 'no-store');

const feedbackOf = (b: ShelfFinishedBook) => {
  const text = locale === 'ua' ? (b.summary.uk ?? b.summary.en) : (b.summary.en ?? b.summary.uk);
  return text ? feedbackHtml(text) : null;
};
const rating = (r: number | null) => (r != null && r >= 1 && r <= 5 ? r : null);
// A few covers come from juggernaut as inline data: URIs, which land in this
// HTML byte for byte (`loading="lazy"` cannot defer them). Keep a small one,
// drop a heavy one rather than let the page grow with the shelf.
const MAX_INLINE_COVER_CHARS = 48 * 1024;
const coverSrc = (url: string | null) =>
  url && url.startsWith('data:') && url.length > MAX_INLINE_COVER_CHARS ? null : url;
---

<BaseLayout
  locale={locale}
  title={strings.sections.books.title}
  description={strings.sections.books.lede}
  alternatePath="books"
  ogImage={`/og/books-${locale}.png`}
>
  <section class="page-frame index">
    <h1 class="sr-only">{strings.sections.books.title}</h1>

    {!shelf ? (
      <p class="empty">{strings.books.unavailable}</p>
    ) : shelf.reading.length === 0 && shelf.finished.length === 0 ? (
      <p class="empty">{strings.empty.books}</p>
    ) : (
      <>
        {shelf.reading.length > 0 && (
          <section class="sub" aria-labelledby="reading-now">
            <h2 id="reading-now" class="workbench sub-label">/ {strings.books.readingNow}</h2>
            <ul class="now" role="list">
              {shelf.reading.map((b) => (
                <li class="now-card">
                  <span class="cover">
                    {coverSrc(b.coverUrl) ? <img src={coverSrc(b.coverUrl)!} alt="" loading="lazy" /> : null}
                  </span>
                  <span class="title">{b.title}</span>
                  {b.authors.length > 0 && <span class="byline">{b.authors.join(', ')}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {shelf.finished.length > 0 && (
          <section class="sub" aria-labelledby="ranking">
            <h2 id="ranking" class="workbench sub-label">/ {strings.books.ranking}</h2>
            <ol class="ledger" role="list">
              {shelf.finished.map((b) => {
                const r = rating(b.rating);
                const feedback = feedbackOf(b);
                return (
                  <li class="row">
                    <span class="rank workbench" aria-hidden={b.rank == null ? 'true' : undefined}>
                      {b.rank != null ? String(b.rank).padStart(2, '0') : '—'}
                    </span>
                    <span class="cover">
                      {coverSrc(b.coverUrl) ? <img src={coverSrc(b.coverUrl)!} alt="" loading="lazy" /> : null}
                    </span>
                    <span class="row-body">
                      <span class="title">{b.title}</span>
                      {b.authors.length > 0 && <span class="byline">{b.authors.join(', ')}</span>}
                      {r != null ? (
                        <span class="stars" aria-label={`${strings.books.rating}: ${r}/5`}>
                          <span class="stars-filled">{'★'.repeat(r)}</span>
                          <span class="stars-empty">{'★'.repeat(5 - r)}</span>
                        </span>
                      ) : (
                        <span class="unranked workbench">{strings.books.unranked}</span>
                      )}
                      {feedback && (
                        <details class="feedback">
                          <summary class="workbench">{strings.books.feedback}</summary>
                          <div class="feedback-body" set:html={feedback} />
                        </details>
                      )}
                    </span>
                  </li>
                );
              })}
            </ol>
          </section>
        )}
      </>
    )}
  </section>
</BaseLayout>

<style>
  .index {
    padding: var(--space-4) var(--space-3) var(--space-6);
  }
  .sub + .sub {
    margin-top: var(--space-6);
  }
  .sub-label {
    color: var(--ink-muted);
    margin: 0 0 var(--space-3);
    font-weight: inherit;
    font-size: inherit;
  }
  .empty {
    color: var(--ink-muted);
    font-style: italic;
  }

  .title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.25;
    color: var(--ink);
  }
  .byline {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  /* Covers carry the page: big, with the hard paper edge of the site's
   * book cards. A missing cover keeps its slot as a blank paper block so the
   * columns stay aligned. */
  .cover {
    display: block;
    aspect-ratio: 2 / 3;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Reading now: a row of covers, title beneath. ──────────────── */
  .now {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-3);
  }
  .now-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .now-card .cover {
    margin-bottom: var(--space-1);
  }

  /* ── The ranking: a numbered ledger, one row per book. ─────────── */
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 2.75rem 8rem 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .rank {
    font-size: 1.15rem;
    line-height: 1.2;
    color: var(--green-primary);
    font-variant-numeric: tabular-nums;
  }
  .row-body {
    min-width: 0;
  }
  .stars {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }
  .stars-filled {
    color: var(--orange-accent);
  }
  .stars-empty {
    color: var(--rule);
  }
  .unranked {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.68rem;
    color: var(--ink-muted);
  }

  /* My feedback: folded by default, one click away. */
  .feedback {
    margin-top: var(--space-2);
    max-width: 62ch;
  }
  .feedback > summary {
    cursor: pointer;
    width: fit-content;
    font-size: 0.72rem;
    color: var(--ink-muted);
  }
  .feedback > summary:hover,
  .feedback[open] > summary {
    color: var(--ink);
  }
  .feedback-body {
    margin-top: var(--space-1);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .feedback-body :global(p) {
    margin: 0 0 0.75em;
  }
  .feedback-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .feedback-body :global(blockquote) {
    margin: 0 0 0.75em;
    padding-left: var(--space-2);
    border-left: 2px solid var(--rule);
    color: var(--ink-muted);
  }
  .feedback-body :global(ul),
  .feedback-body :global(ol) {
    margin: 0 0 0.75em;
    padding-left: 1.25em;
  }

  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1.75rem 5.5rem 1fr;
      gap: var(--space-2);
    }
    .rank {
      font-size: 0.95rem;
    }
    .now {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }
  }
</style>
