---
export const prerender = true;
import { LOCALES, t, localePath, type Locale } from '@lib/i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLabsByLocale, labSlug } from '@lib/content';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const strings = t(locale);
const labs = await getLabsByLocale(locale);
---

<BaseLayout locale={locale} title={strings.nav.lab} alternatePath="lab" themeLab>
  <section class="page-frame lab-index">
    {labs.length === 0 ? (
      <p class="empty">{strings.empty.lab}</p>
    ) : (
      <ul class="pins" role="list">
        {labs.map((lab) => (
          <li>
            <a
              class="pin"
              href={lab.data.externalUrl ?? localePath(locale, `lab/${labSlug(lab)}`)}
              {...(lab.data.externalUrl ? { target: '_blank', rel: 'noreferrer' } : {})}
            >
              <div class="pin-media">
                {lab.data.cover ? (
                  <img src={lab.data.cover} alt={lab.data.title} loading="lazy" decoding="async" />
                ) : (
                  <span class="pin-fallback" aria-hidden="true">{lab.data.title.charAt(0)}</span>
                )}
              </div>
              <div class="pin-caption">
                <p class="pin-title">{lab.data.title}</p>
                {!lab.data.hideCardSummary && <p class="pin-summary">{lab.data.summary}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .lab-index {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3) var(--space-6);
  }
  .empty {
    color: var(--ink-muted);
    font-style: italic;
  }

  /* Pinterest-style masonry: as many ~260px columns as fit, cards flow to
     shortest column. No page header — the cards are the whole page. */
  .pins {
    columns: 260px 3;
    column-gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pins > li {
    break-inside: avoid;
    margin: 0 0 var(--space-3);
  }

  .pin {
    display: block;
    border: 1px solid var(--rule);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-elevated);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .pin:hover,
  .pin:focus-visible {
    border-color: var(--orange-bright);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    outline: none;
  }

  .pin-media {
    aspect-ratio: 4 / 5;
    background: var(--bg-paper);
  }
  .pin-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Fallback when a lab has no cover image yet. */
  .pin-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(150deg, var(--orange-soft), var(--green-soft, var(--bg-paper)));
    font-family: var(--font-mono);
    font-size: 3.5rem;
    color: var(--orange-bright);
  }

  .pin-caption {
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
  .pin-title {
    margin: 0 0 0.25rem;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
  }
  .pin:hover .pin-title,
  .pin:focus-visible .pin-title {
    color: var(--orange-bright);
  }
  .pin-summary {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.4;
  }
</style>
