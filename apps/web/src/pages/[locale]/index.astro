---
export const prerender = true;
import { LOCALES, t, localePath, languageBadge, bcp47Locale, localized, type Locale } from '@lib/i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Timeline from '@components/Timeline.astro';
import RelativeDays from '@components/RelativeDays.tsx';
import {
  bookSlug,
  getAnnouncements,
  getStampedBooks,
  getStampedLinks,
  getTalks,
  getWritingTalkingTimeline,
} from '@lib/content';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const strings = t(locale);

const today = new Date();
today.setHours(0, 0, 0, 0);
function atMidnight(d: Date): Date {
  const x = new Date(d);
  x.setHours(0, 0, 0, 0);
  return x;
}

const allTalks = await getTalks();
const upcomingTalks = allTalks
  .filter((talk) => atMidnight(talk.data.date) >= today)
  .reverse(); // soonest first

/* "Catch me at" shows two different things that read as one list.
 *
 *  - A future-dated `talks` entry: an appearance already written up in the archive.
 *  - An `announcements` entry: announced, not yet delivered, and deliberately NOT in
 *    the archive — see content/config.ts for why they are separate collections.
 *
 * Normalised here into one shape so the block below stays a single template rather
 * than two near-identical ones. BOTH link IN, to their own detail page: an announcement
 * now has one (/announcements/<slug>/), which is where the conference link, the ticket
 * link and the abstract live. Sending the title straight out to the conference site —
 * what this used to do — spent the click before the reader had read anything.
 *
 * De-duplicated on event+day: once a talk graduates into the archive, its
 * announcement may still be sitting there, and the same appearance must not print
 * twice. The archive entry wins — it is the richer record. */
interface ProgrammeItem {
  key: string;
  date: Date;
  /** Last day this stays listed. Differs from `date` for a multi-day conference:
      the tile shows the START, but the item must survive until the event ENDS. */
  until: Date;
  event: string;
  title: string;
  href: string;
  external: boolean;
  language?: 'en' | 'ua';
  videoUrl?: string;
}
/* Calendar day as YYYY-MM-DD, read in UTC.
   `z.coerce.date()` turns date-only frontmatter into midnight UTC. Serialising that as
   an instant and re-parsing it client-side lands on the PREVIOUS day for any viewer west
   of UTC — which would hide a 26–27 Nov conference through the whole of the 27th in New
   York. Comparing plain date strings sidesteps time zones entirely. */
const utcDay = (date: Date) =>
  `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
const dayKey = (event: string, date: Date) => `${event.toLowerCase()}|${atMidnight(date).getTime()}`;

const talkItems: ProgrammeItem[] = upcomingTalks.map((talk) => ({
  key: talk.slug,
  date: talk.data.date,
  until: talk.data.date,
  event: talk.data.event,
  title: talk.data.title,
  href: localePath(locale, `talks/${talk.slug}`),
  external: false,
  ...(talk.data.language ? { language: talk.data.language } : {}),
  ...(talk.data.videoUrl ? { videoUrl: talk.data.videoUrl } : {}),
}));

const announcementItems: ProgrammeItem[] = (await getAnnouncements()).map((a) => ({
  key: a.data.talkSlug ?? dayKey(a.data.event, a.data.date),
  date: a.data.date,
  until: a.data.endDate ?? a.data.date,
  event: (locale === 'ua' ? a.data.eventUk : undefined) ?? a.data.event,
  title: (locale === 'ua' ? a.data.titleUk : undefined) ?? a.data.title,
  href: localePath(locale, `announcements/${a.slug}`),
  external: false,
  ...(a.data.language ? { language: a.data.language } : {}),
}));

/* Both identities go in: an announcement matches EITHER by its explicit talkSlug or,
   when it has none, by event+day. Seeding the set with only one of them would make the
   documented fallback unreachable and print the same appearance twice. */
const seen = new Set([
  ...allTalks.map((t) => t.slug),
  ...allTalks.map((t) => dayKey(t.data.event, t.data.date)),
]);
const upcoming: ProgrammeItem[] = [
  ...talkItems,
  ...announcementItems.filter((a) => !seen.has(a.key)),
].sort((a, b) => a.date.getTime() - b.date.getTime());

/* Recent stream: render the merged writing & talking timeline plus hidden
 * upcoming-talk candidates. Static builds can go stale overnight: the
 * programme block already hides passed talks client-side, so the recent list
 * needs those same talks in the DOM to reveal them once they become past.
 * On desktop a clamp script hides whatever doesn't fit the viewport. */
const RECENT_COUNT = 8;
const timeline = await getWritingTalkingTimeline(locale);
const recent = [
  ...timeline.filter((e) => e.kind === 'talk' && atMidnight(e.date) >= today),
  ...timeline.filter((e) => !(e.kind === 'talk' && atMidnight(e.date) >= today)).slice(0, RECENT_COUNT),
].sort((a, b) => b.date.getTime() - a.date.getTime());

/* From the shelf: promote any inspiration entry worth recommending — books
 * and links alike, gated at 4–5 stars. Newest server-rendered; the whole
 * pool serialized so a tiny script can deal a random one per visit. */
interface ShelfItem {
  title: string;
  byline: string;
  cover: string | null;
  rating: number | null;
  summary: string;
  href: string;
  external: boolean;
  date: number;
}
const [stampedBooks, stampedLinks] = await Promise.all([getStampedBooks(locale), getStampedLinks()]);
const shelfPool: ShelfItem[] = [
  ...stampedBooks.map((book): ShelfItem => ({
    title: book.data.title,
    byline: `${strings.books.by} ${book.data.author}`,
    cover: book.data.cover,
    rating: book.data.rating ?? null,
    // The shelf card is the one place a book's blurb skipped localized() — /ua/ printed the
    // English summary next to an otherwise Ukrainian page. Feeds the SSR card AND the
    // client-side shuffle payload, so this single line covers both.
    summary: localized(locale, book.data.summary, book.data.summaryUk),
    href: localePath(locale, `books/${bookSlug(book)}`),
    external: false,
    date: book.data.readAt?.getTime() ?? 0,
  })),
  ...stampedLinks.map((link): ShelfItem => ({
    title: link.data.title,
    byline: link.data.source,
    cover: link.data.thumbnail ?? null,
    rating: link.data.rating ?? null,
    // Same as books above: localize the shelf blurb so /ua/ doesn't print the
    // English summary of a promoted link next to an otherwise Ukrainian page.
    summary: localized(locale, link.data.summary, link.data.summaryUk) ?? '',
    href: link.data.url,
    external: true,
    date: link.data.readAt?.getTime() ?? 0,
  })),
];
const shelf = shelfPool
  .filter((it) => (it.rating ?? 0) >= 4)
  .sort((a, b) => b.date - a.date)
  .map(({ date: _date, ...rest }) => rest);
const shelfFirst = shelf[0];
function starsOf(rating: number | null): string | null {
  return rating ? '★'.repeat(rating) + '☆'.repeat(5 - rating) : null;
}

const monthFmt = new Intl.DateTimeFormat(bcp47Locale(locale), { month: 'short' });
const rtf = new Intl.RelativeTimeFormat(bcp47Locale(locale), { numeric: 'auto' });
const daysFromToday = (date: Date): number =>
  Math.round((atMidnight(date).getTime() - today.getTime()) / 86_400_000);

function calMonth(date: Date): string {
  return monthFmt.format(date).replace(/\.$/, '').toUpperCase();
}
---

<BaseLayout locale={locale} description={strings.site.metaDescription} alternatePath="" fullViewport hideFooter>
  <div class="home">
    {/* ── Cover: the journal's identity rail ──────────────────────── */}
    <aside class="cover">
      <div class="cover-banner">
        <img src="/home/banner.jpg" alt="" loading="eager" />
      </div>
      <div class="cover-body">
        <img class="avatar" src="/home/avatar.jpg" alt={strings.site.title} loading="eager" />
        <h1 class="display">{strings.site.title}</h1>
        <p class="role">{strings.home.role}</p>
        <p class="workbench location">
          ▸ {strings.home.location} <span class="flag" aria-hidden="true">🇺🇦</span>
        </p>
      </div>
      <nav class="elsewhere" aria-label={strings.home.elsewhere}>
        <a
          class="elsewhere-main"
          href="https://www.linkedin.com/in/yarik-yermilov/"
          rel="me noopener"
          target="_blank"
          aria-label={strings.home.followLinkedIn}
        >
          <span class="elsewhere-eyebrow" aria-hidden="true">→ {strings.home.elsewhere}</span>
          <span class="elsewhere-headline" aria-hidden="true">
            LinkedIn<span class="elsewhere-arrow">↗</span>
          </span>
          <span class="elsewhere-handle" aria-hidden="true">in/yarik-yermilov</span>
        </a>
        <ul class="elsewhere-links" role="list">
          <li><a href="https://github.com/yermilov" rel="me">github</a></li>
          <li><a href="https://twitter.com/yermilov17" rel="me">twitter</a></li>
          <li><a href={`${localePath(locale)}rss.xml`}>rss</a></li>
          <li><a href={localePath(locale, 'writing-talking/kit')}>kit</a></li>
        </ul>
      </nav>
    </aside>

    {/* ── Contents: programme on top, recent | shelf below ─────────── */}
    <div class="contents">
      <section class="programme" data-programme="upcoming" hidden={upcoming.length === 0}>
        <p class="workbench programme-label">→ {strings.home.catchMeAt}</p>
        <ul class="programme-list" role="list">
          {upcoming.map((item) => {
            return (
              <li
                class="programme-item"
                data-iso={item.date.toISOString()}
                data-until={utcDay(item.until)}
              >
                <div class="cal-tile" aria-hidden="true">
                  <span class="cal-mo">{calMonth(item.date)}</span>
                  <span class="cal-day">{item.date.getDate()}</span>
                  <span class="cal-yr">{item.date.getFullYear()}</span>
                </div>
                <div class="programme-content">
                  <p class="workbench event">
                    ▸ <span>{item.event}</span>
                  </p>
                  <h2 class="programme-title">
                    {item.href ? (
                      <a
                        href={item.href}
                        {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
                      >
                        {item.title}
                      </a>
                    ) : (
                      /* Announced with nowhere to point yet — a speaker is often named
                         before the organiser publishes a page. Show it anyway. */
                      item.title
                    )}
                  </h2>
                  <p class="workbench meta">
                    <RelativeDays
                      client:idle
                      iso={item.date.toISOString()}
                      bcp47={bcp47Locale(locale)}
                      fallback={rtf.format(daysFromToday(item.date), 'day')}
                      serverDays={daysFromToday(item.date)}
                    />
                    {item.language && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{languageBadge(item.language)}</span>
                      </>
                    )}
                    {item.videoUrl && (
                      <>
                        <span aria-hidden="true">·</span>
                        <a
                          class="youtube-glyph"
                          href={item.videoUrl}
                          rel="noopener"
                          aria-label={strings.labels.video}
                          title={strings.labels.video}
                        >
                          <svg viewBox="0 0 24 16" aria-hidden="true" focusable="false">
                            <path d="M23.5 2.5c-.3-1.1-1.1-1.9-2.2-2.2C19.4 0 12 0 12 0S4.6 0 2.7.3C1.6.6.8 1.4.5 2.5.2 4.4.2 8 .2 8s0 3.6.3 5.5c.3 1.1 1.1 1.9 2.2 2.2 1.9.3 9.3.3 9.3.3s7.4 0 9.3-.3c1.1-.3 1.9-1.1 2.2-2.2.3-1.9.3-5.5.3-5.5s0-3.6-.3-5.5Z" />
                            <path class="youtube-glyph-triangle" d="M9.7 11.4V4.6L15.8 8l-6.1 3.4Z" />
                          </svg>
                        </a>
                      </>
                    )}
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <div class="lower">
        <section class="recent" hidden={recent.length === 0}>
          <div class="recent-head">
            <p class="workbench recent-label">/ {strings.home.recent}</p>
            <a class="workbench recent-all" href={localePath(locale, 'writing-talking')}>
              {strings.home.everything}
            </a>
          </div>
          <div class="recent-clip" data-recent-clamp data-recent-max={RECENT_COUNT}>
            <Timeline locale={locale} entries={recent} compact hideUpcoming />
          </div>
        </section>

        {shelfFirst && (
          <section class="shelf">
            <div class="recent-head">
              <p class="workbench recent-label">/ {strings.home.fromTheShelf}</p>
              <a class="workbench recent-all" href={localePath(locale, 'inspiration')}>
                {strings.home.moreInspiration}
              </a>
            </div>
            <div class="shelf-card" data-shelf-card>
              <a
                class="shelf-cover"
                href={shelfFirst.href}
                data-shelf-cover
                aria-hidden="true"
                tabindex="-1"
                {...(shelfFirst.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <img src={shelfFirst.cover ?? ''} alt="" data-shelf-img hidden={!shelfFirst.cover} />
                <span class="shelf-glyph" data-shelf-glyph aria-hidden="true" hidden={!!shelfFirst.cover}>✦</span>
              </a>
              <div class="shelf-meta">
                {starsOf(shelfFirst.rating) && (
                  <p class="workbench shelf-stars" data-shelf-stars>{starsOf(shelfFirst.rating)}</p>
                )}
                <h2 class="shelf-title">
                  <a href={shelfFirst.href} data-shelf-link {...(shelfFirst.external ? { target: '_blank', rel: 'noopener' } : {})}>{shelfFirst.title}</a>
                </h2>
                <p class="shelf-author" data-shelf-author>{shelfFirst.byline}</p>
                <p class="shelf-summary" data-shelf-summary>{shelfFirst.summary}</p>
              </div>
            </div>
            <script is:inline type="application/json" data-shelf-data set:html={JSON.stringify({ items: shelf })} />
          </section>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // "Catch me at" self-corrects on stale static builds: hide passed talks,
  // hide the whole block when none remain.
  {
    const section = document.querySelector<HTMLElement>('[data-programme="upcoming"]');
    if (section) {
      const now = new Date();
      const todayKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
      let visible = 0;
      section.querySelectorAll<HTMLElement>('.programme-item').forEach((item) => {
        // Expire on data-until (the event's LAST day), not data-iso (its first) —
        // otherwise a 26–27 Nov conference disappears on the 27th, mid-event.
        // data-until is a plain YYYY-MM-DD (the event's LAST day). Compared as a
        // string against the viewer's LOCAL calendar day, so no time zone can shift it
        // — an instant would read as the previous day anywhere west of UTC.
        const until = item.getAttribute('data-until');
        const iso = item.getAttribute('data-iso');
        if (!until && !iso) return;
        const expires =
          until ??
          (() => {
            const d = new Date(iso as string);
            return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
          })();
        if (expires < todayKey) item.hidden = true;
        else visible += 1;
      });
      if (visible === 0) section.hidden = true;
    }
  }

  // Recent self-correction + clamp. Keep static builds fresh overnight: talks
  // rendered as hidden upcoming candidates become recent once their date is in
  // the past. Then cap to the newest visible items and, on viewport-locked
  // desktop, hide rows that still overflow the column.
  {
    const clip = document.querySelector<HTMLElement>('[data-recent-clamp]');
    if (clip) {
      const lock = window.matchMedia('(min-width: 960px) and (min-height: 620px)');
      const items = Array.from(clip.querySelectorAll<HTMLElement>(':scope li'));
      const maxVisible = Number(clip.dataset.recentMax ?? '8');
      const apply = () => {
        items.forEach((li) => (li.hidden = false));
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        let visible = 0;
        items.forEach((li) => {
          const iso = li.getAttribute('data-iso');
          const isUpcomingTalk = li.hasAttribute('data-upcomable');
          if (iso && isUpcomingTalk) {
            // Plain calendar-day comparison, same as the programme block above.
            // Parsing the midnight-UTC instant here instead would land on the previous
            // local day west of UTC and reveal the row while the programme still shows
            // it — the same appearance printed in both sections all day.
            const d = new Date(iso);
            const isoDay = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
            const nowR = new Date();
            const todayDay = `${nowR.getFullYear()}-${String(nowR.getMonth() + 1).padStart(2, '0')}-${String(nowR.getDate()).padStart(2, '0')}`;
            if (isoDay >= todayDay) {
              li.hidden = true;
              return;
            }
          }
          visible += 1;
          if (visible > maxVisible) li.hidden = true;
        });
        if (!lock.matches) return;
        const limit = clip.getBoundingClientRect().bottom;
        let cut = false;
        let keptFirst = false;
        items.forEach((li) => {
          if (li.hidden) return;
          if (!keptFirst) {
            keptFirst = true;
            return;
          }
          if (!cut && li.getBoundingClientRect().bottom > limit + 1) cut = true;
          if (cut) li.hidden = true;
        });
      };
      apply();
      lock.addEventListener('change', apply);
      window.addEventListener('resize', () => requestAnimationFrame(apply));
      document.fonts?.ready.then(apply);
    }
  }

  // From the shelf: deal a random recommended inspiration entry (book or
  // link) per visit. The newest is server-rendered as the no-JS fallback.
  {
    const data = document.querySelector<HTMLScriptElement>('[data-shelf-data]');
    const card = document.querySelector<HTMLElement>('[data-shelf-card]');
    if (data && card) {
      try {
        const { items } = JSON.parse(data.textContent || '{}') as {
          items: Array<{
            title: string;
            byline: string;
            cover: string | null;
            rating: number | null;
            summary: string;
            href: string;
            external: boolean;
          }>;
        };
        if (Array.isArray(items) && items.length > 1) {
          const pick = items[Math.floor(Math.random() * items.length)];
          if (pick) {
            const img = card.querySelector<HTMLImageElement>('[data-shelf-img]');
            const glyph = card.querySelector<HTMLElement>('[data-shelf-glyph]');
            const coverLink = card.querySelector<HTMLAnchorElement>('[data-shelf-cover]');
            const link = card.querySelector<HTMLAnchorElement>('[data-shelf-link]');
            const author = card.querySelector<HTMLElement>('[data-shelf-author]');
            const summary = card.querySelector<HTMLElement>('[data-shelf-summary]');
            const stars = card.querySelector<HTMLElement>('[data-shelf-stars]');
            const setTarget = (a: HTMLAnchorElement | null) => {
              if (!a) return;
              a.href = pick.href;
              if (pick.external) {
                a.target = '_blank';
                a.rel = 'noopener';
              } else {
                a.removeAttribute('target');
                a.removeAttribute('rel');
              }
            };
            if (img && glyph) {
              if (pick.cover) {
                img.src = pick.cover;
                img.hidden = false;
                glyph.hidden = true;
              } else {
                img.hidden = true;
                glyph.hidden = false;
              }
            }
            setTarget(coverLink);
            setTarget(link);
            if (link) link.textContent = pick.title;
            if (author) author.textContent = pick.byline;
            if (summary) summary.textContent = pick.summary;
            if (stars) {
              if (pick.rating) {
                stars.textContent = '★'.repeat(pick.rating) + '☆'.repeat(5 - pick.rating);
                stars.hidden = false;
              } else {
                stars.hidden = true;
              }
            }
          }
        }
      } catch {
        // malformed JSON → keep the server-rendered fallback
      }
    }
  }
</script>

<style>
  /* ════════════════════════════════════════════════════════════════
     The journal cover spread. Desktop is a split screen: a full-height
     identity rail on the left (banner crop, avatar, name, LinkedIn),
     the three content sections on the right — locked to one viewport.
     Mobile keeps the familiar stacked, scrolling flow.
     ════════════════════════════════════════════════════════════════ */

  [hidden] {
    display: none !important;
  }

  /* ── Base (mobile-first, stacked) ───────────────────────────────── */

  .cover-banner {
    width: 100%;
    aspect-ratio: 1400 / 360;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
  }
  .cover-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .cover-body {
    padding: 0 var(--space-3);
  }
  .avatar {
    width: 152px;
    height: 152px;
    margin-top: -60px;
    border-radius: 50%;
    border: 5px solid var(--bg-paper);
    object-fit: cover;
    background: var(--bg-paper);
    display: block;
  }
  .display {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: var(--space-2) 0 0.25rem;
    line-height: 1.08;
  }
  .flag {
    display: inline-block;
    margin-left: 0.15rem;
    font-size: 1.1em;
    vertical-align: -0.08em;
  }
  .role {
    font-size: 1.1rem;
    color: var(--ink);
    margin: 0 0 0.3rem;
  }
  .location {
    margin: var(--space-1) 0 0;
    color: var(--green-primary);
  }

  /* "Elsewhere" callout — purely typographic, the workbench vocabulary:
     mono eyebrow with a → glyph, serif headline, mono caption, and the
     full link ledger (the homepage has no footer; it lives here). */
  .elsewhere {
    border-top: 1px solid var(--rule);
    margin: var(--space-3) var(--space-3) 0;
    padding: var(--space-2) 0 0;
  }
  .elsewhere-main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    line-height: 1.1;
    color: var(--ink);
    border-bottom: none;
  }
  .elsewhere-main:hover {
    background: transparent;
    color: var(--ink);
  }
  .elsewhere-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--green-primary);
  }
  .elsewhere-headline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--ink);
    transition: color 140ms ease;
  }
  .elsewhere-arrow {
    display: inline-block;
    margin-left: 0.18em;
    font-size: 0.65em;
    color: var(--orange-accent);
    transition: transform 160ms ease, color 160ms ease;
    vertical-align: 0.4em;
  }
  .elsewhere-handle {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }
  .elsewhere-main:hover .elsewhere-headline {
    color: var(--orange-accent);
  }
  .elsewhere-main:hover .elsewhere-arrow {
    transform: translate(2px, -2px);
    color: var(--orange-bright);
  }
  .elsewhere-main:hover .elsewhere-handle {
    color: var(--ink);
  }
  .elsewhere-links {
    list-style: none;
    margin: var(--space-3) 0 0;
