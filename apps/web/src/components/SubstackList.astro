---
/**
 * Writing & talking as a Substack-style publication feed — the platform's LAYOUT (a
 * clean, text-forward list of article previews, each a title + dek + byline-ish meta,
 * with an optional square thumbnail on the right) reinterpreted in the site's Field
 * Journal aesthetic: 1px rule dividers between rows, paper/ink tones, serif titles + mono
 * meta, NO drop shadows or rounded "card" chrome. Posts and talks share the row grammar;
 * the title keeps the full-row click target while recordings remain distinct links.
 * A tiny date check lets stale prerenders graduate an upcoming talk into the archive.
 */
import { postSlug, type TimelineEntry } from '@lib/content';
import { languageBadge, localePath, localized, t, type Locale } from '@lib/i18n';
import YouTubeGlyph from '@components/YouTubeGlyph.astro';

interface Props {
  locale: Locale;
  entries: TimelineEntry[];
  /** Keep future talks out of the archive feed until their date passes. */
  hideUpcoming?: boolean;
}
const { locale, entries, hideUpcoming = false } = Astro.props;
const strings = t(locale);

const dateFmt = new Intl.DateTimeFormat(locale === 'ua' ? 'uk-UA' : 'en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Future-dated talks are "upcoming" (matches Timeline). Computed at build; a small script
// below re-checks on load so a stale prerender stops flagging a talk once its date passes.
const today = new Date();
const todayDay = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
const utcDay = (date: Date) =>
  `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
function isUpcoming(d: Date): boolean {
  return utcDay(d) >= todayDay;
}

type Row = {
  href: string;
  kind: 'post' | 'talk';
  kindLabel: string;
  title: string;
  dek: string;
  metaExtra: string | undefined;
  badge: string | undefined;
  thumb: string | undefined;
  videoUrl: string | undefined;
  date: Date;
  iso: string;
  day: string;
  upcoming: boolean;
};

const rows: Row[] = [];
for (const entry of entries) {
  if (entry.kind === 'post') {
    const p = entry.post;
    rows.push({
      href: localePath(locale, `blog/${postSlug(p)}`),
      kind: 'post',
      kindLabel: strings.timeline.post,
      title: p.data.title,
      dek: p.data.summary,
      metaExtra: undefined,
      badge: languageBadge(p.data.language),
      thumb: p.data.coverImage,
      videoUrl: undefined,
      date: entry.date,
      iso: entry.date.toISOString(),
      day: utcDay(entry.date),
      upcoming: false,
    });
  } else if (entry.kind === 'talk') {
    const tk = entry.talk;
    const abstract = localized(locale, tk.data.abstract, tk.data.abstractUk);
    rows.push({
      href: localePath(locale, `talks/${tk.slug}`),
      kind: 'talk',
      // An interview and a panel are not доповіді — label each appearance by what it actually was.
      kindLabel: strings.timeline[tk.data.format],
      title: localized(locale, tk.data.title, tk.data.titleUk),
      dek: abstract.split(/\n\n+/)[0] ?? '',
      metaExtra: localized(locale, tk.data.event, tk.data.eventUk),
      badge: tk.data.language ? languageBadge(tk.data.language) : undefined,
      // An explicit `cover` (promo still / key art) wins; otherwise borrow the first event photo,
      // which is how every talk got its thumbnail before `cover` existed.
      thumb: tk.data.cover ?? tk.data.photos?.[0],
      videoUrl: tk.data.videoUrl,
      date: entry.date,
      iso: entry.date.toISOString(),
      day: utcDay(entry.date),
      upcoming: isUpcoming(entry.date),
    });
  }
}
---

<ul class="feed" role="list">
  {
    rows.map((row) => (
      <li
        class="item"
        data-iso={row.iso}
        data-day={row.day}
        data-upcomable={row.upcoming ? '' : undefined}
        hidden={hideUpcoming && row.upcoming}
      >
        <article class={`row row-${row.kind}`}>
          <span class="body">
            <span class="meta">
              <span class="kind">{row.kindLabel}</span>
              {row.upcoming ? (
                <span class="upcoming" data-upcoming-tag>{strings.timeline.upcoming}</span>
              ) : null}
              {row.metaExtra ? <span class="meta-part"> · {row.metaExtra}</span> : null}
              <span class="meta-part"> · {dateFmt.format(row.date)}</span>
              {row.badge ? <span class="badge">{row.badge}</span> : null}
              {row.videoUrl ? (
                <>
                  <span aria-hidden="true"> · </span>
                  <YouTubeGlyph href={row.videoUrl} label={strings.labels.video} />
                </>
              ) : null}
            </span>
            <span class="title"><a class="title-link" href={row.href}>{row.title}</a></span>
            {row.dek ? <span class="dek">{row.dek}</span> : null}
          </span>
          {row.thumb ? (
            <span class="thumb">
              <img src={row.thumb} alt="" loading="lazy" />
            </span>
          ) : null}
        </article>
      </li>
    ))
  }
</ul>

<script>
  // A static build's "today" goes stale between deploys — re-check upcoming talks on load
  // so a talk whose date has passed loses its "upcoming" tag (mirrors Timeline).
  const now = new Date();
  const todayDay = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  document.querySelectorAll<HTMLElement>('[data-upcomable]').forEach((el) => {
    const day = el.dataset.day;
    if (day && day < todayDay) {
      el.hidden = false;
      el.querySelector('[data-upcoming-tag]')?.remove();
    }
  });
</script>

<style>
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 46rem;
  }
  /* Rule dividers between entries — the feed reads as one column, no card chrome. */
  .item {
    border-top: 1px solid var(--rule);
  }
  .item:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-1);
    /* Field Journal depth is tonal + rule, never shadow. */
    transition: background-color 0.16s ease;
  }
  .body {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .kind {
    color: var(--green-primary);
  }
  /* Future-dated talk marker — orange, so a scheduled talk never reads as a past one. */
  .upcoming {
    margin-left: 0.5em;
    color: var(--orange-accent);
    font-weight: 600;
  }
  .badge {
    margin-left: 0.5em;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 0.3em;
    font-size: 0.9em;
    color: var(--ink-muted);
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--ink);
    transition: color 0.16s ease;
  }
  .title-link {
    color: inherit;
    border-bottom: none;
    -webkit-tap-highlight-color: transparent;
  }
  /* Preserve the feed's full-row click target while keeping the YouTube glyph
     as its own valid link instead of nesting one anchor inside another. */
  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title-link:hover {
    background: transparent;
  }
  .title-link:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .title-link:focus-visible::after {
    border-radius: 2px;
    box-shadow: var(--focus-ring);
  }
  .row:has(.title-link:active) {
    background: var(--orange-soft);
  }
  @media (hover: hover) and (pointer: fine) {
    .row:hover {
      background: var(--bg-elevated);
    }
    .row:hover .title {
      color: var(--green-primary);
    }
  }
  @media (hover: none) {
    .title-link:hover {
      color: inherit;
    }
  }
  .dek {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  /* Square thumbnail on the right — the platform's article-image slot, only when a piece
     has one; text-only rows just run full width. */
  .thumb {
    flex: 0 0 auto;
    width: 6.5rem;
    height: 6.5rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--bg-elevated);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 34rem) {
    .row {
      gap: var(--space-2);
    }
    .title {
      font-size: 1.15rem;
    }
    .thumb {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
</style>
