---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  class="youtube-glyph"
  href={href}
  rel="noopener"
  aria-label={label}
  title={label}
>
  <svg viewBox="0 0 24 16" aria-hidden="true" focusable="false">
    <path d="M23.5 2.5c-.3-1.1-1.1-1.9-2.2-2.2C19.4 0 12 0 12 0S4.6 0 2.7.3C1.6.6.8 1.4.5 2.5.2 4.4.2 8 .2 8s0 3.6.3 5.5c.3 1.1 1.1 1.9 2.2 2.2 1.9.3 9.3.3 9.3.3s7.4 0 9.3-.3c1.1-.3 1.9-1.1 2.2-2.2.3-1.9.3-5.5.3-5.5s0-3.6-.3-5.5Z" />
    <path class="triangle" d="M9.7 11.4V4.6L15.8 8l-6.1 3.4Z" />
  </svg>
</a>

<style>
  .youtube-glyph {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    color: var(--orange-accent);
    vertical-align: -0.08em;
    border-bottom: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .youtube-glyph:focus-visible {
    background: transparent;
    color: var(--ink);
  }
  .youtube-glyph:active {
    color: var(--green-primary);
    transform: scale(0.94);
  }
  @media (hover: hover) and (pointer: fine) {
    .youtube-glyph:hover {
      background: transparent;
      color: var(--ink);
    }
  }
  @media (hover: none) {
    .youtube-glyph:hover {
      background: transparent;
      color: var(--orange-accent);
    }
  }
  svg {
    width: 1.22rem;
    height: 0.82rem;
    display: block;
    fill: currentColor;
  }
  .triangle {
    fill: var(--bg-paper);
  }
</style>
