---
import { bcp47Locale, type Locale } from '@lib/i18n';
import { t } from '@lib/i18n';
import BaseLayout from './BaseLayout.astro';
import TranslationPendingBanner from '@components/TranslationPendingBanner.astro';

interface Props {
  locale: Locale;
  title: string;
  description?: string | undefined;
  publishedAt: Date;
  updatedAt?: Date | undefined;
  coverImage?: string | undefined;
  alternatePath?: string | undefined;
  alternateMissing?: boolean;
  /** the original-language post body is being shown as a fallback */
  translationPending?: boolean;
  /** language of the post body that is actually being shown */
  sourceLocale: Locale;
  /** path to the post's social card under /og/ */
  ogImage?: string | undefined;
  /** page-specific JSON-LD (BlogPosting), forwarded to BaseLayout */
  jsonLd?: object | undefined;
}

const {
  locale,
  title,
  description,
  publishedAt,
  updatedAt,
  coverImage,
  alternatePath,
  alternateMissing = false,
  translationPending = false,
  sourceLocale,
  ogImage,
  jsonLd,
} = Astro.props;

const strings = t(locale);
const fmt = new Intl.DateTimeFormat(bcp47Locale(locale), { dateStyle: 'long' });
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  alternatePath={alternatePath}
  alternateMissing={alternateMissing}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <article class="page-frame post" data-pagefind-body>
    <header class="post-header prose-column">
      {translationPending && <TranslationPendingBanner locale={locale} sourceLocale={sourceLocale} />}
      <p class="workbench post-meta">
        <time datetime={publishedAt.toISOString()}>{fmt.format(publishedAt)}</time>
        {updatedAt && (
          <>
            <span aria-hidden="true">·</span>
            <span>{strings.labels.updated}: {fmt.format(updatedAt)}</span>
          </>
        )}
      </p>
      <h1>{title}</h1>
    </header>
    {coverImage && (
      <figure class="post-cover prose-column">
        <img src={coverImage} alt="" loading="eager" />
      </figure>
    )}
    <div class="post-body prose-column">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    /* width of the companion-figure column — a phone screenshot reads well
       around 300px and, at the reading measure, still fits inside .page-frame */
    --aside-column: 19rem;
    padding: var(--space-5) var(--space-3) var(--space-6);
  }
  .post-header {
    margin-bottom: var(--space-4);
  }
  .post-meta {
    margin-bottom: var(--space-2);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post-cover {
    margin: 0 0 var(--space-4);
  }
  .post-cover img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
    border: 1px solid var(--rule);
  }
  .post-body :global(img),
  .post-body :global(video) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--rule);
  }
  /* ── Companion figure (`<figure class="post-aside">`) ──────────────
     A tall portrait screenshot is a companion to the text, not an illustration
     that wants the full measure: at the reading width it eats a whole screen and
     leaves the column beside it empty. Narrow viewports keep it in the flow,
     capped to phone width; from 60rem it sits beside the text (below). Its place
     in the MDX source is never changed, so the stacked order — and what a screen
     reader hears — stays the author's. */
  .post-body :global(figure.post-aside img) {
    display: block;
    width: auto;
    max-width: min(var(--aside-column), 100%);
    max-height: 70vh;
    margin-inline: auto;
  }
  @media (min-width: 60rem) {
    /* Header and body both widen by exactly one aside column, so the title, the
       date stamp and every paragraph keep one shared left edge and one shared
       reading width — only the frame around them grew. */
    .post:has(figure.post-aside) .post-header,
    .post:has(figure.post-aside) .post-cover,
    .post:has(figure.post-aside) .post-body {
      max-width: calc(var(--measure) + var(--space-5) + var(--aside-column));
    }
    /* a float, not a grid column: a grid row would tie the figure's height to
       whichever block shares its row and open a screen of dead space under that
       block. Floating decouples them — the text simply continues underneath. */
    .post:has(figure.post-aside) .post-body {
      display: flow-root;
    }
    /* `calc`, not `--measure`, because `--measure` is `68ch` and `ch` re-resolves
       against each element's own font-size: on the h1 that is ~1700px, i.e. no cap
       at all. Subtracting from 100% keeps the cap in the container's own units and
       shrinks it in step with the frame. `:global` on all three because a bare `*`
       is scoped to an attribute selector that skips any child rendered by ANOTHER
       component — which is exactly what the translation-pending banner is. */
    .post:has(figure.post-aside) .post-header > :global(*),
    .post:has(figure.post-aside) .post-cover > :global(*),
    .post:has(figure.post-aside) .post-body > :global(*) {
      max-width: calc(100% - var(--space-5) - var(--aside-column));
    }
    .post:has(figure.post-aside) .post-body > :global(figure.post-aside) {
      float: right;
      width: var(--aside-column);
      max-width: none;
      margin: 0 0 var(--space-3) var(--space-5);
    }
    .post-body :global(figure.post-aside img) {
      /* the column already IS the image's width, so no viewport-height cap */
      width: 100%;
      max-height: none;
    }
  }
  /* Restore default list bullets/numbers — Tailwind Preflight strips them
     globally and we don't use the typography plugin, so prose lists need
     their own scoped re-enable. */
  .post-body :global(ul) {
    list-style: disc outside;
    padding-inline-start: 1.4rem;
  }
  .post-body :global(ol) {
    list-style: decimal outside;
    padding-inline-start: 1.6rem;
  }
  .post-body :global(li) {
    margin-bottom: 0.4rem;
  }
  .post-body :global(li:last-child) {
    margin-bottom: 0;
  }
  .post-body :global(li > ul),
  .post-body :global(li > ol) {
    margin-top: 0.4rem;
  }
  .post-body :global(li > ul) {
    list-style-type: circle;
  }
  .post-body :global(li > ul ul) {
    list-style-type: square;
  }
</style>
