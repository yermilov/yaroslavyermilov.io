---
import { bcp47Locale, type Locale } from '@lib/i18n';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
  title: string;
  description?: string | undefined;
  publishedAt: Date;
  alternatePath?: string | undefined;
  alternateMissing?: boolean;
  /** 'full' runs the island edge-to-edge (no prose header / max-width) for a
   * full-screen lab; 'default' keeps the reading column + LAB header. */
  layout?: 'default' | 'full';
  /** Drop the <h1> only, keeping the date line and the lede. For a lab whose body opens with its
   * own hook and would just repeat the title back at the reader. (`layout: 'full'` also hides the
   * title, but it takes the date and the lede with it — this is the narrow lever.) */
  hideTitle?: boolean;
  /** Drop the visible lede. `description` is still passed to BaseLayout for the meta description —
   * this only stops it being printed above a body that already opens with the same thought. */
  hideLede?: boolean;
}

const {
  locale,
  title,
  description,
  publishedAt,
  alternatePath,
  alternateMissing = false,
  layout = 'default',
  hideTitle = false,
  hideLede = false,
} = Astro.props;
const full = layout === 'full';

const fmt = new Intl.DateTimeFormat(bcp47Locale(locale), { dateStyle: 'long' });
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  alternatePath={alternatePath}
  alternateMissing={alternateMissing}
  themeLab
>
  <article class:list={['page-frame', 'lab', { 'lab--full': full }]} data-pagefind-body>
    {
      !full && (
        <header class="lab-header prose-column">
          <p class="workbench">
            <time datetime={publishedAt.toISOString()}>{fmt.format(publishedAt)}</time> · LAB
          </p>
          {!hideTitle && <h1>{title}</h1>}
          {description && !hideLede && <p class="lede">{description}</p>}
        </header>
      )
    }
    <div class:list={['lab-body', { 'lab-body--full': full }]}>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .lab {
    padding: var(--space-5) var(--space-3) var(--space-6);
  }
  .lab-header {
    margin-bottom: var(--space-4);
  }
  .lede {
    font-size: 1.2rem;
    color: var(--ink-muted);
  }
  .lab-body {
    /* Lab content is allowed to break the prose column for full-bleed visualizations. */
    max-width: 80rem;
    margin-inline: auto;
  }
  /* Full-screen labs: no reading-column constraint, minimal padding, and enough
     height for the island to fill the viewport below the site header. */
  .lab--full {
    padding: var(--space-3) var(--space-3) var(--space-4);
  }
  .lab-body--full {
    max-width: none;
    margin-inline: 0;
  }
</style>
