---
import type { Locale } from '@lib/i18n';
import { t, htmlLang, ogLocale, otherLocale, localePath } from '@lib/i18n';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PhotoLightbox from '@components/PhotoLightbox.astro';
import StandWithUkraineBanner from '@components/StandWithUkraineBanner.astro';
import '@styles/tokens.css';

interface Props {
  locale: Locale;
  title?: string | undefined;
  description?: string | undefined;
  /** sub-path (no locale prefix) of the alternate translation */
  alternatePath?: string | undefined;
  alternateMissing?: boolean;
  /** apply theme-lab inversion (used for /lab/ pages) */
  themeLab?: boolean;
  /** lock the page chrome to the viewport on desktop (used by the homepage) */
  fullViewport?: boolean;
  /** omit the shared footer (the homepage folds its links into the cover rail) */
  hideFooter?: boolean;
  /** when true, robots noindex (drafts, error pages) */
  noindex?: boolean;
  /** path to the page's social card under /og/, defaults to the home card */
  ogImage?: string | undefined;
  /** page-specific JSON-LD (BlogPosting / Event …), emitted alongside the site-wide Person */
  jsonLd?: object | undefined;
}

const {
  locale,
  title,
  description,
  alternatePath,
  alternateMissing = false,
  themeLab = false,
  fullViewport = false,
  hideFooter = false,
  noindex = false,
  ogImage,
  jsonLd,
} = Astro.props;

const strings = t(locale);
const fullTitle = title ? `${title} — ${strings.site.title}` : strings.site.title;
const meta = description ?? strings.site.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage ?? `/og/home-${locale}.png`, Astro.site).toString();

// Complete hreflang set (self + other + x-default), only when a translated counterpart
// exists. x-default points at the EN version (the canonical entry point for non-JS agents).
const otherHref =
  alternatePath !== undefined && !alternateMissing
    ? new URL(localePath(otherLocale(locale), alternatePath), Astro.site).toString()
    : undefined;
const xDefaultHref = locale === 'en' ? canonical : otherHref;

// Serialize JSON-LD safely: escape `<` so a content-derived string (a post title with
// "</script>") can never break out of the inline <script>.
const ldJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');

// Site-wide Person structured data — lets an agent read "who / what / where" without
// parsing prose. Emitted on every page; per-page BlogPosting/Event arrives via `jsonLd`.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yaroslav Yermilov',
  alternateName: 'Yarik Yermilov',
  jobTitle: 'Principal Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Superhuman' },
  url: new URL('/en/', Astro.site).toString(),
  image: new URL('/home/avatar.jpg', Astro.site).toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Kyiv', addressCountry: 'UA' },
  knowsAbout: [
    'AI-first software engineering',
    'LLM agents',
    'Software engineering',
    'Developer productivity',
  ],
  sameAs: [
    'https://www.linkedin.com/in/yarik-yermilov/',
    'https://github.com/yermilov',
    'https://twitter.com/yermilov17',
  ],
};
---

<!doctype html>
<html lang={htmlLang(locale)} data-pagefind-filter={`language:${locale}`} data-pagefind-meta={`language:${locale}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={meta} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={meta} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${strings.site.title} (${locale.toUpperCase()})`} href={`/${locale}/rss.xml`} />
    {otherHref !== undefined && (
      <Fragment>
        <link rel="alternate" hreflang={htmlLang(locale)} href={canonical} />
        <link rel="alternate" hreflang={htmlLang(otherLocale(locale))} href={otherHref} />
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
      </Fragment>
    )}
    <script type="application/ld+json" is:inline set:html={ldJson(personLd)} />
    {jsonLd !== undefined && (
      <script type="application/ld+json" is:inline set:html={ldJson(jsonLd)} />
    )}
    {import.meta.env.PROD && (
      <Fragment>
        <script is:inline async src="https://plausible.io/js/pa-M8AOqaq3j7YY412uq6p9W.js"></script>
        <script is:inline>
          window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
          plausible.init()
        </script>
      </Fragment>
    )}
  </head>
  <body class:list={[{ 'theme-lab': themeLab, 'full-viewport': fullViewport }]}>
    <StandWithUkraineBanner />
    <Header locale={locale} alternatePath={alternatePath} alternateMissing={alternateMissing} />
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} />}
    <PhotoLightbox locale={locale} />
    <script is:inline data-locale={locale}>
      // «Also available in …» hint: shown when the page's language differs
      // from the visitor's preference (remembered switcher choice, falling
      // back to the browser language) AND a translation exists — detected via
      // the switcher's live link, so there is zero per-page wiring. Google's
      // i18n guidance: offer the choice, never auto-redirect content pages.
      (function () {
        var cur = document.currentScript.dataset.locale;
        var pref = null;
        try {
          pref = localStorage.getItem('yy-lang');
        } catch (e) {}
        if (pref !== 'ua' && pref !== 'en')
          pref = (navigator.language || '').toLowerCase().indexOf('uk') === 0 ? 'ua' : 'en';
        if (pref === cur) return;
        try {
          if (sessionStorage.getItem('yy-lang-hint-dismissed')) return;
        } catch (e) {}
        var alt = document.querySelector('a.locale-switch[data-target-locale="' + pref + '"]');
        if (!alt) return;
        // Only promise a translation when one actually EXISTS: the switcher
        // falls back to the other locale's homepage when a page has no
        // counterpart (404 and friends) — hinting there would mislead. The
        // homepages themselves are exact counterparts of each other.
        var isHome = /^\/(en|ua)\/?$/.test(location.pathname);
        if (alt.dataset.counterpart !== 'exact' && !isHome) return;
        var bar = document.createElement('div');
        bar.className = 'lang-hint';
        var link = document.createElement('a');
        link.href = alt.getAttribute('href');
        link.textContent = pref === 'ua' ? 'Ця сторінка є українською →' : 'This page is also available in English →';
        var close = document.createElement('button');
        close.type = 'button';
        close.setAttribute('aria-label', pref === 'ua' ? 'Закрити' : 'Dismiss');
        close.textContent = '×';
        close.addEventListener('click', function () {
          try {
            sessionStorage.setItem('yy-lang-hint-dismissed', '1');
          } catch (e) {}
          bar.remove();
        });
        bar.appendChild(link);
        bar.appendChild(close);
        document.body.appendChild(bar);
      })();
    </script>
    <style is:global>
      .lang-hint {
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--bg-elevated);
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 8px 8px 8px 16px;
        box-shadow: 4px 6px 0 0 var(--rule); /* the site's hard offset shadow (TweetCard) */
        z-index: 60;
        /* This file declares exactly one family, for one small component; the page's
           actual pairing (Newsreader + JetBrains Mono) lives in styles/tokens.css,
           which this file-scoped rule cannot see. */
        /* impeccable-disable-next-line single-font -- see above */
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.02em;
      }
      .lang-hint a {
        color: var(--green-deep);
        text-decoration: none;
      }
      .lang-hint a:hover {
        text-decoration: underline;
      }
      .lang-hint button {
        border: 0;
        background: transparent;
        color: var(--ink-muted);
        font-size: 1rem;
        line-height: 1;
        padding: 4px 8px;
        cursor: pointer;
      }
    </style>
  </body>
</html>
