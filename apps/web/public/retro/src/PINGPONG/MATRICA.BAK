uses crt;
begin
     ClrScr;
     repeat
           TextColor(Green);
           writeln('01010100 10111100 01001010 10100101 01001010 10010100 10101101 01001101');
           delay(2000);
           writeln('10101011 01100011 10111110 00000010 10110101 00101001 01010000 10100010');
           delay(2000);
           writeln('01011010 10001010 10100001 11010101 01001010 11001010 11001100 10100101');
           delay(2000);
     until keypressed;
end.
